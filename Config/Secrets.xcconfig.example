// Copy to Config/Secrets.xcconfig (git-ignored) and fill in the values from
// Supabase Dashboard → Project Settings → API.
//
// Use ONLY the project URL and the *publishable* (anon) key. NEVER put the service-role / secret key in the app.
//
// xcconfig treats "//" as a comment, so the URL's slashes are escaped with $() :
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY_HERE
